<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>OfflineRaidProtection</AssemblyName>
    <RootNamespace>OfflineRaidProtection</RootNamespace>
    <LangVersion>latest</LangVersion>
    <DebugType>none</DebugType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <!-- The game's assemblies are publicized; suppress the noise that causes. -->
    <NoWarn>$(NoWarn);CS0436;CS1701</NoWarn>
    <Managed>C:\AMPDatastore\Instances\LastBreath7Days01\seven-days-to-die\294420\7DaysToDieServer_Data\Managed</Managed>
    <Harmony>C:\AMPDatastore\Instances\LastBreath7Days01\seven-days-to-die\294420\Mods\0_TFP_Harmony</Harmony>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(Managed)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(Managed)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="LogLibrary">
      <HintPath>$(Managed)\LogLibrary.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(Harmony)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
